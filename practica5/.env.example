# Copia este archivo como .env (NO lo subas al repositorio)
# Genera uno con: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_un_valor_aleatorio_de_al_menos_32_caracteres
# Client ID de tipo "Aplicación web" de Google Cloud (el mismo que usa la app Android como serverClientId)
GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Correos que recibirán rol administrador (separados por coma)
ADMIN_EMAILS=admin@ejemplo.com
