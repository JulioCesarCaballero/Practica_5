<?xml version="1.0" encoding="utf-8"?>
<!-- Toda la comunicación remota debe usar HTTPS: el tráfico en texto plano está prohibido. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
